# Local Postgres por enquanto (ver docker-compose.yml — `docker compose up
# -d` sobe na porta 5434). O projeto Supabase DEDICADO do ufersin
# (retmfoorwjwzuevaqlsr, via Session Pooler) fica guardado pra quando a
# integração real com Supabase acontecer:
#   postgresql://postgres.<project-ref>:<senha>@aws-<n>-<região>.pooler.supabase.com:5432/postgres?sslmode=require
# IMPORTANTE (quando voltar a usar Supabase): use o Session Pooler, não a
# conexão direta (db.<project-ref>.supabase.co) — essa só tem endereço
# IPv6, e numa rede sem IPv6 de verdade (comum em provedor residencial no
# Brasil) a conexão fica pendurada até estourar o timeout.
DATABASE_URL=postgresql://postgres:postgres@localhost:5434/postgres

# O motor de e-commerce (ecommerce/backend) também roda na 8080 por padrão
# — precisa dessa porta diferente pra rodar os dois ao mesmo tempo local.
PORT=8081

# URL do MESMO projeto Supabase usado pelo frontend (ver
# frontend/.env.example VITE_SUPABASE_URL), ex: https://<project-ref>.supabase.co.
# Usado só pra buscar o JWKS público do projeto (Settings -> API -> JWT
# Keys) e VERIFICAR localmente os tokens que o Supabase Auth emite pro
# lojista (ver auth.rs::AuthSubscriber / jwks.rs) -- este backend nunca
# emite token nenhum, nunca fala com o banco do Supabase pra validar
# sessão. Sem isso, toda rota autenticada responde 401 sempre. Não precisa
# de nenhum secret: o endpoint JWKS é público (só chaves públicas).
SUPABASE_URL=https://replace-with-project-ref.supabase.co

# Token de produção (APP_USR-...) ou de teste (TEST-...) do Mercado Pago,
# de uma conta com o produto de Assinaturas/Preapproval aprovado. Vazio =
# modo mock (não cobra de verdade, só testa o fluxo). Quando presente,
# é o gateway padrão pra novas assinaturas Resolutoo (ver gateway.rs).
MP_ACCESS_TOKEN=

# Chave da AbacatePay (app.abacatepay.com). Vazio = modo mock. Usada como
# fallback só quando MP_ACCESS_TOKEN não está setado. Assinantes antigos
# com gateway=abacatepay continuam sendo consultados/cancelados nele.
ABACATEPAY_API_KEY=

# Valor mensal padrão cobrado do lojista, em reais (fallback — o valor real
# vem do plano escolhido no checkout, ver routes/assinatura.rs::plan_price).
PLANO_VALOR_MENSAL=99.00

# Pra onde o gateway manda o lojista de volta depois do checkout (autorizado
# ou não) — a página de status do frontend.
BACK_URL=http://localhost:5174/obrigado

CORS_ORIGINS=http://localhost:5174

# Base URL do motor de e-commerce (ecommerce/backend) + chave compartilhada
# pra chamar POST /internal/provision-tenant no fim do onboarding — precisa
# bater com INTERNAL_API_KEY em ecommerce/backend/.env.
ECOMMERCE_INTERNAL_URL=http://localhost:8080
ECOMMERCE_INTERNAL_KEY=replace-with-a-random-shared-secret

# PandaDoc — só contrato do lojista em /assinar (platform_subscription).
# Checkout do cliente = checkbox local, sem PandaDoc (não gasta cota).
# Free + Sandbox no Dev Center; vazio = só checkbox em /assinar.
# Docs: docs/CONTRATOS_PANDADOC.md
PANDADOC_API_KEY=
PANDADOC_API_BASE=https://api.pandadoc.com
PANDADOC_SANDBOX=true
PANDADOC_PLATFORM_TEMPLATE_ID=

# Seed do superadmin (script backend/scripts/seed_superadmin.mjs) — NUNCA commitar senha.
# SUPABASE_SERVICE_ROLE_KEY=
# SUPERADMIN_SEED_EMAIL=tipatetamuurcho@gmail.com
# SUPERADMIN_SEED_PASSWORD=
