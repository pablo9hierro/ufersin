# Projeto Supabase DEDICADO do ufersin (não é o compartilhado do
# sunset/vrtech/juete). Usa o schema "public" padrão direto, sem precisar
# de isolamento por schema já que não tem outro site dividindo esse banco.
#
# IMPORTANTE: use o Session Pooler (porta 5432, host
# aws-<n>-<região>.pooler.supabase.com, usuário "postgres.<project-ref>"),
# não a conexão direta (db.<project-ref>.supabase.co) — essa só tem
# endereço IPv6, e numa rede sem IPv6 de verdade (comum em provedor
# residencial no Brasil) a conexão fica pendurada até estourar o timeout
# do pool ("pool timed out while waiting for an open connection"). Pegue a
# string certa em Project Settings -> Database -> Connect -> Session
# pooler. Caracteres especiais na senha precisam ser percent-encoded
# (ex.: "?" -> "%3F").
DATABASE_URL=postgresql://postgres.<project-ref>:<senha>@aws-<n>-<região>.pooler.supabase.com:5432/postgres?sslmode=require

# Token de produção (APP_USR-...) ou de teste (TEST-...) do Mercado Pago,
# de uma conta com o produto de Assinaturas/Preapproval aprovado. Vazio =
# modo mock (não cobra de verdade, só testa o fluxo).
MP_ACCESS_TOKEN=

# Valor mensal padrão cobrado do lojista, em reais.
PLANO_VALOR_MENSAL=99.00

# Pra onde o Mercado Pago manda o lojista de volta depois do checkout
# (autorizado ou não) — a página de assinatura do frontend.
BACK_URL=http://localhost:5174/obrigado

CORS_ORIGINS=http://localhost:5174
