# Local Postgres for now (see backend/docker-compose.yml — `docker compose
# up -d` starts it on port 5433). Supabase integration is deliberately not
# wired up yet; when it is, this becomes the same kind of Supabase
# connection string juite/backend/.env.example uses.
DATABASE_URL=postgresql://postgres:postgres@localhost:5433/postgres
JWT_SECRET=replace-with-a-random-40-plus-character-secret
WHATSAPP_GATEWAY_URL=http://localhost:3001
# Chave de API da AbacatePay (app.abacatepay.com -> Configurações ->
# Chaves de API) pra habilitar Pix de verdade. Vazio = modo mock (QR falso,
# nenhuma cobrança real) — aguardando o lojista criar a conta na AbacatePay
# e ceder a chave.
ABACATEPAY_API_KEY=
# Chave da Google Routes API (Google Cloud Console -> Routes API ativada
# -> Credenciais). Habilita rota real por rua respeitando trânsito/mão-e-
# contramão de verdade, tanto na navegação do motoboy quanto na otimização
# de ordem de entrega em lote. Vazio = cai pro OSRM (rota) e pro heurístico
# de distância em linha reta (lote) — aguardando o lojista assinar a API e
# ceder a chave.
GOOGLE_ROUTES_API_KEY=
# Comma-separated list of frontend origins allowed to call this API —
# inclui a Rodoletas (5174) porque /demo de lá chama /demo/tokens aqui
# direto do navegador.
CORS_ORIGINS=http://localhost:5173,http://localhost:5174,https://resolutoo.com,https://www.resolutoo.com

# ---- One-time seed values only (backend/src/seed.rs) ----
# Pickup address / Evolution API instance name for the single demo tenant
# this seeds on first run. NOT read at request time — those are per-tenant
# columns on `tenants` now (whatsapp_instance, pickup_address), since a
# single global value would leak one tenant's info onto every tenant's
# messages. Editing these after the first run has no effect; update the
# `tenants` row directly (or through the future admin UI) instead.
SEED_STORE_PICKUP_ADDRESS=Rua Exemplo, 123 - Centro, João Pessoa - PB
SEED_EVOLUTION_INSTANCE=resolutoo-demo
