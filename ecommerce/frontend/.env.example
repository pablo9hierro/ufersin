# URL do backend (Railway, quando estiver no ar). Sem isso, cai no localhost:8080.
VITE_API_BASE_URL=https://sua-api.up.railway.app

# ---- Admin live tests (npm run test:admin) — never commit real secrets ----
# Prefer putting these in .env.local (gitignored). Suite fails if missing.
# ADMIN_TEST_BASE_URL=https://sua-api.up.railway.app
# ADMIN_TEST_EMAIL=admin@sua-loja.com
# ADMIN_TEST_PASSWORD=
# ADMIN_TEST_TENANT=sua-loja
# ADMIN_TEST_DATABASE_URL=postgres://…
# ADMIN_TEST_ALLOW_PDV_SALE=0
# ADMIN_TEST_UI_URL=https://seu-front.vercel.app/loja

# Backend da plataforma Rodoletas/ufersin (login>assinar>onboarding do lojista) --
# usado só pra ler a config real do onboarding (Pedidos/WhatsApp/forma de
# pagamento), nunca pra autenticação. Sem isso, cai no localhost:8080.
VITE_RODOLETAS_API_URL=https://sua-api-rodoletas.up.railway.app
# Slug do tenant que ESTE deploy representa (resolução automática por
# subdomínio é trabalho futuro da Fase 1B, ver ecommerce/README-TENANCY.md).
VITE_TENANT_SLUG=sunset-tabas

# Se VITE_SUPABASE_URL/ANON_KEY estiverem configuradas (chamadas diretas ao
# catálogo/checkout/admin via supabase-js), este é o schema Postgres usado
# -- schema isolado do Ufersin, nunca o `sunset` (produção real da Sunset
# Tabas). Ver ecommerce/supabase-ufersin/0000_bootstrap_ufersin_schema.sql.
VITE_SUPABASE_SCHEMA=ufersin
