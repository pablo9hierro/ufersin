{
  "buildCommand": "bash scripts/embed-loja-demo.sh && npm run build",
  "outputDirectory": "dist",
  "framework": "vite",
  "rewrites": [
    { "source": "/loja", "destination": "/loja/index.html" },
    { "source": "/loja/(.*)", "destination": "/loja/index.html" },
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
