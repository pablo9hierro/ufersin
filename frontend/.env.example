VITE_API_BASE_URL=http://localhost:8081

# URL pública deste frontend (links de confirmação / reset do Supabase Auth).
# Em produção o build já cai pra https://resolutoo.com se vazio — mas o
# Dashboard Supabase (Authentication → URL Configuration) TAMBÉM precisa
# ter Site URL = https://resolutoo.com e Redirect URLs cobrindo
# https://resolutoo.com/auth/callback e https://resolutoo.com/**
VITE_SITE_URL=http://localhost:5174

# URL do frontend do motor de e-commerce (ecommerce/frontend).
# Local: deixe em http://localhost:5173 (demo e dashboard usam essa).
# Em produção, a demo NÃO precisa dessa env — o deploy embute o motor em
# /loja no mesmo domínio (ver scripts/embed-loja-demo.sh). Só configure
# aqui se quiser apontar a demo pra outro host.
VITE_ECOMMERCE_FRONTEND_URL=http://localhost:5173
# URL do BACKEND do motor de e-commerce — só usada por /demo, pra buscar
# token de acesso à loja demo pública (GET /demo/tokens lá).
VITE_ECOMMERCE_API_URL=http://localhost:8080

# WhatsApp/e-mail reais de contato da Rodoletas — substituir antes de publicar.
VITE_CONTACT_WHATSAPP=5500000000000
VITE_CONTACT_EMAIL=contato@rodoletas.com

# Auth nativo do Supabase pro login/cadastro do lojista (ver ARQUITETURA.md
# §6) — mesmo projeto Supabase do motor de e-commerce, chave anônima.
# Dashboard desse projeto precisa ter Site URL/Redirect URLs cobrindo este
# frontend e "Confirm email" habilitado em Authentication -> Settings.
VITE_SUPABASE_URL=https://migkkrwzykpztrakbfij.supabase.co
VITE_SUPABASE_ANON_KEY=replace-with-the-project-anon-key
